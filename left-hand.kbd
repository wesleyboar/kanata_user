;; Kanata configuration for the accessibility keyboard layout

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =   
  bspc tab  q    w    e    r    t    y    u    i    o    p    [    ]   
  \    caps a    s    d    f    g    h    j    k    l    ;    '    ret 
  lsft z    x    c    v    b    n    m    ,    .    /    rsft lctl
  lmet lalt spc  ralt rmet rctl
)

(defalias
  mir (tap-hold-release 200 200 spc (layer-while-held spc-mirror))
  nav-toggle (switch
    ((layer base)) (layer-switch nav) break
    ((layer nav))  (layer-switch base) break
    ()             XX break
  )
  pun (tap-dance 200 (
    (tap-hold-release 200 200 caps (layer-while-held cap-punct))
    @nav-toggle
  ))
  nvc (tap-dance 200 (lctl @nav-toggle))
  paren-q (switch
    ((and lsft lalt)) [ break
    (lsft) S-9 break
    ()      [ break
  )
  paren-e (switch
    ((and lsft lalt)) ] break
    (lsft) S-0 break
    ()      ] break
  )
  pun-d (switch
    (lsft) del break
    ()      bspc break
  )
  punc-spc  lsft
  punc-d    @pun-d
)

;; Double-tapping Caps enters and exits the persistent navigation layer.
;; Space+Caps produces Return while in NAV.
;; Q/E produce parentheses when the layer's Shift key is held.
(defchordsv2
  (spc caps)  ret        500 all-released (base cap-punct spc-mirror)
)

(defoverrides
  (lsft bspc) (del)
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =   
  bspc tab  q    w    e    r    t    y    u    i    o    p    [    ]   
  \    @pun a    s    d    f    g    h    j    k    l    ;    '    ret 
  lsft z    x    c    v    b    n    m    ,    .    /    rsft lctl
  lmet lalt @mir ralt rmet rctl
)

(deflayer spc-mirror
  grv  6    7    8    9    0    1    2    3    4    5    _    _   
  bspc bspc p    o    i    u    y    t    r    e    w    q    _    _   
  \    ret  '    l    k    j    h    g    f    d    s    a    _    _   
  lsft /    .    ,    m    n    b    v    c    x    z    rsft lctl
  lmet lalt XX   ralt rmet rctl
)

(deflayer cap-punct
  0    -    =    _    _    _    _    _    _    _    _    _    _   
  _    \    @paren-q XX   @paren-e XX   (multi lsft grv) _    _    _    _    _    _    _   
  _    _    '    ;    @pun-d  _    grv  _    _    _    _    _    _    _
  _    /    .    ,    _    _    _    _    _    _    _    _    _
  _    _    @punc-spc _    _    _   
)

(deflayer nav
  _    -    =    _    _    _    _    _    _    _    _    _    _
  _    bspc  @paren-q up   @paren-e spc  tab  _    _    _    _    _    _    _
  _    @nvc  left down rght S-ret _    _    _    _    _    _    _    _
  lalt /    .    ,    _    _    _    _    _    _    _    _    _
  _    _    lsft _    _    _
)
