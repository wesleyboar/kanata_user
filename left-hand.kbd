;; Kanata configuration for the accessibility keyboard layout

(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =   
  bspc tab  q    w    e    r    t    y    u    i    o    p    [    ]   
  \    caps a    s    d    f    g    h    j    k    l    ;    '    ret 
  lsft z    x    c    v    b    n    m    ,    .    /    rsft lctl
  lmet lalt spc  ralt rmet rctl
)

(defalias
  mir (tap-hold-release 200 200 spc (layer-while-held spc-mirror))
  pun (tap-hold-release 200 200 caps (layer-while-held cap-punct))
  punc-lsft (chord punc-del s)
  punc-d    (chord punc-del d)
  punc-spc  (chord punc-del spc)
)

(defoverrides
  (lsft bspc) (del)
)

(defchords punc-del 200
  (s)    lsft
  (d)    bspc
  (spc)  lsft
  (s d)  del
  (spc d) del
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =   
  bspc tab  q    w    e    r    t    y    u    i    o    p    [    ]   
  \    @pun a    s    d    f    g    h    j    k    l    ;    '    ret 
  lsft z    x    c    v    b    n    m    ,    .    /    rsft lctl
  lmet lalt @mir ralt rmet rctl
)

(deflayer spc-mirror
  grv  6    7    8    9    0    1    2    3    4    5    _    _   
  bspc bspc p    o    i    u    y    t    r    e    w    q    _    _   
  \    ret  '    l    k    j    h    g    f    d    s    a    _    _   
  lsft /    .    ,    m    n    b    v    c    x    z    rsft lctl
  lmet lalt XX   ralt rmet rctl
)

(deflayer cap-punct
  0    -    =    _    _    _    _    _    _    _    _    _    _   
  _    \    [    ]    (multi lsft 9) (multi lsft 0) (multi lsft grv) _    _    _    _    _    _    _   
  _    _    '    ;    @punc-d  _    grv  _    _    _    _    _    _    _   
  @punc-lsft /    .    ,    _    _    _    _    _    _    _    _    _   
  _    _    @punc-spc _    _    _   
)
